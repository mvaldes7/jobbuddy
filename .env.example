# Copy to .env for local dev. NAMES ONLY - never commit real values.
# In GitHub Actions these come from repository secrets/variables. There is no LLM API key and no
# IMAP account: the on-box AI agent does that work via `jobbuddy agent-*` commands.

# --- Database (Postgres/Neon primary; Azure SQL and SQLite also supported) ---
# Pooled runtime URL (role jobbuddy_app, DML only). Used by the pipeline and the dashboard.
# Pooled runtime URL, e.g. postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=
# Direct (non-pooled) owner URL, used ONLY by Alembic (migrate.yml / local)
DATABASE_URL_DIRECT=

# Transport for raw-SQL agent commands: sqlalchemy (default; CI, dashboard) | neon_http (on-box agent:
# Neon serverless SQL over HTTPS, for machines that cannot reach port 5432)
DATABASE_TRANSPORT=
# Optional override of the Neon HTTP endpoint (default https://<host of DATABASE_URL>/sql)
NEON_HTTP_ENDPOINT=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Approvals / notifications (Telegram primary) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sender user id allowed to approve; defaults to TELEGRAM_CHAT_ID (private chat)
TELEGRAM_ALLOWED_USER_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
# telegram | slack | email | none
NOTIFIER=

# --- Candidate profile (JSON form of profile/profile.yaml; overrides the file) ---
CANDIDATE_PROFILE_JSON=

# --- Safety switches ---
# false by default: approved applications are only submitted by `jobbuddy submit --confirm`
# (in CI: repository variable AUTO_SUBMIT, unset => false)
AUTO_SUBMIT=false
DRY_RUN=false
DAILY_APPLICATION_CAP=
HEADLESS=true

# --- Dashboard ---
DASHBOARD_PASSWORD=

# --- Optional overrides ---
JOBBUDDY_CONFIG=
JOBBUDDY_COMPANIES=
